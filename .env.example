# --- Application -----------------------------------------------------------
APP_NAME="Meher Cuisine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Never change the timezone after real data exists: stored times are in this zone.
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Database (MySQL / MariaDB, utf8mb4) -----------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurent
DB_USERNAME=root
DB_PASSWORD=

# --- Session, cache, queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail ------------------------------------------------------------------
# Local: "log" writes emails to storage/logs. Production: use smtp (see docs/DEPLOYMENT.md).
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nmbabu6040@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Security --------------------------------------------------------------
# enforce | report-only | off
SECURITY_CSP=enforce

# --- Admin account created by AdminSeeder ----------------------------------
# Leave ADMIN_PASSWORD empty to get a random one printed once. Remove it from .env after seeding.
ADMIN_EMAIL=nmbabu6040@gmail.com
ADMIN_PASSWORD=password

# --- Ordering --------------------------------------------------------------
ORDERING_ENABLED=true
ORDER_DELIVERY=true
ORDER_PICKUP=true
DELIVERY_FEE=60
FREE_DELIVERY_OVER=1500
MIN_ORDER=200
CURRENCY_SYMBOL="৳"
# Kitchen alert email; empty = the email set in Admin > Settings
ORDER_ALERT_EMAIL=
ORDER_CITY=Dhaka
UNPAID_ORDER_EXPIRY=60

# --- Online payment (SSLCommerz) -------------------------------------------
ONLINE_PAYMENT=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- Reservations ----------------------------------------------------------
RESERVATION_CAPACITY=40
RESERVATION_DURATION=90
RESERVATION_OPEN=11:00
RESERVATION_LAST_SEATING=21:30


INVENTORY_ENFORCE_RECIPE=false
VITE_APP_NAME="${APP_NAME}"
